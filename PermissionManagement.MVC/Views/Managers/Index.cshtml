@model IEnumerable<PermissionManagement.MVC.Models.Manager>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using PermissionManagement.MVC.Constants
@{
    ViewData["Title"] = "Index";
}

<h1>Monthly Meal Manager List:</h1>

<partial name="_PertialView" />

@if ((AuthorizationService.AuthorizeAsync(User, Permissions.Managers.View)).Result.Succeeded)
{
    <div class="col-md-5">
        <a asp-controller="Managers" asp-action="Create" class="btn btn-primary" style="width: 155px ">
            <i class="bi bi-plus-circle"></i> &nbsp;Add Manager
        </a>
    </div>
}

<br />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Month)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FromDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ToDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Month)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FromDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ToDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Member.Name)
            </td>
            <td>
                    @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Deposits.Edit)).Result.Succeeded)
                    {
                        <a asp-action="Edit" class="btn btn-info" asp-route-id="@item.ManagerId"><i class="bi bi-pencil-square"></i></a>
                    }
                    @*<a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.Id"><i class="bi bi-trash-fill"></i></a> *@
            </td>
        </tr>
}
    </tbody>
</table>
