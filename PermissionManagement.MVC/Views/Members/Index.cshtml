@model IEnumerable<PermissionManagement.MVC.Models.Member>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using PermissionManagement.MVC.Constants

@{
    ViewData["Title"] = "Index";
}

<h1>All Member List:</h1>

<div class="row mb-3">
    
<partial name="_PertialView" />
    @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Members.View)).Result.Succeeded)
    {
        <div class="col-md-5">
            <a asp-controller="Members" asp-action="Create" class="btn btn-primary" style="width: 155px ">
                <i class="bi bi-plus-circle"></i> &nbsp;Add Member
            </a>
        </div>
    }
   
    <div class="col-md-6 text-right">
        <form method="get" asp-action="Index">
            <div class="input-group">
                <input type="text" name="searchString" class="form-control" placeholder="Search by Name or Mobile No.." value="@ViewData["CurrentFilter"]" />
                <div class="input-group-append">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-search fa-sm"></i> Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<br />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MemberId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MobileNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MemberId)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MobileNo)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
            <td>
                    @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Members.Edit)).Result.Succeeded)
                    {
                        <a asp-action="Edit" class="btn btn-info" asp-route-id="@item.MemberId"><i class="bi bi-pencil-square"></i></a>
                    }
                    @*@if ((AuthorizationService.AuthorizeAsync(User, Permissions.Members.Delete)).Result.Succeeded)
                    {
                        <a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.MemberId"><i class="bi bi-trash-fill"></i></a>
                    }*@                 
            </td>
        </tr>
}
    </tbody>
</table>
